CONFIG_SONY_UART_LINK=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3
CONFIG_SONY_UART_AUDIO_NODE=y
CONFIG_SONY_SCREEN_BENCH=n
CONFIG_SONY_MANUAL_CONTROLS=n
CONFIG_SONY_I2S_MIRROR=n
CONFIG_AUDIO_OUTPUT_SPDIF=n
CONFIG_LED_RGB_GPIO=-1
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-radio.csv"
